# Generate local values with npm run setup. Never commit .env.
DATABASE_URL=postgresql://little_app:CHANGE_ME@127.0.0.1:54329/little_english
POSTGRES_PASSWORD=CHANGE_ME
PORT=3001
# Production only: exact public HTTPS origin (no trailing slash)
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-domain.example
# DB_SSL=true
# DB_DRIVER=auto
# DB_SSL_CA_FILE=/path/to/provider-ca.crt
# DB_CONNECT_TIMEOUT_MS=10000
# DB_IDLE_TIMEOUT_MS=30000
# DB_POOL_SIZE=10
# TRUST_PROXY=true
# Google OAuth (optional; create credentials in Google Cloud Console)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
