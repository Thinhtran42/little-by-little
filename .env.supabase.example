# Copy to .env.supabase (ignored by Git). Never paste real credentials into chat.
# Use the exact Direct or Session pooler connection string from Supabase Connect.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:5432/postgres
DB_DRIVER=postgres
DB_SSL=true
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=10000
# Set if the provider requires its CA certificate. Never disable verification.
# DB_SSL_CA_FILE=C:/secure/supabase-ca.crt
