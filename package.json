{
  "name": "little-by-little",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.prod.config.js",
    "format": "prettier --write frontend/src shared backend tests e2e *.js *.json",
    "check": "npm test && npm run test:api && npm run test:e2e && npm run build && npm run test:offline",
    "dev:frontend": "vite --config frontend/vite.config.js --host 0.0.0.0",
    "dev:backend": "node --env-file-if-exists=.env backend/index.js",
    "start": "node --env-file-if-exists=.env backend/index.js",
    "db:migrate": "node --env-file-if-exists=.env backend/db/manage.js migrate",
    "db:seed": "node --env-file-if-exists=.env backend/db/manage.js seed",
    "test:api": "node --test backend/tests/*.test.js",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "fastify": "^5.12.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
